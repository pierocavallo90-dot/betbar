<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>BETBAR-ORACLE | V17 BROADCAST</title>
    
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#00f0ff">

    <style>
        :root {
            --bg-color: #02040a;
            --panel-bg: rgba(10, 15, 25, 0.95);
            --border-glow: rgba(0, 240, 255, 0.4);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --cyan-accent: #00f0ff;
            --violet-accent: #b026ff;
            --gold-accent: #fbbf24;
            --green-value: #10b981;
            --red-value: #ef4444;
            --neon-green: #00ff00;
        }

        * { box-sizing: border-box; }
        
        html, body { 
            margin: 0; padding: 0; width: 100vw; height: 100vh; 
            background-color: var(--bg-color);
            background-image: radial-gradient(circle at center, #0a1128 0%, #02040a 100%);
            color: var(--text-main); 
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; 
            overflow: hidden; 
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(0, 240, 255, 0.3); border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--cyan-accent); }

        .top-nav {
            display: flex; justify-content: space-between; align-items: center; 
            height: 60px; background: #000; border-bottom: 2px solid var(--violet-accent);
            padding: 0 20px; box-shadow: 0 0 20px rgba(176, 38, 255, 0.2);
            z-index: 100; position: relative;
        }
        .logo-area { font-size: 1.8rem; font-weight: 900; color: #fff; text-shadow: 0 0 10px var(--cyan-accent); letter-spacing: 2px; }
        .logo-area span { color: var(--cyan-accent); }
        
        .match-tabs { display: flex; gap: 5px; flex-grow: 1; justify-content: center; overflow-x: auto; }
        .m-tab { background: transparent; color: var(--text-muted); border: none; font-weight: 900; font-size: 1rem; padding: 0 15px; cursor: pointer; transition: 0.3s; border-bottom: 3px solid transparent; outline: none; }
        .m-tab:hover { color: #fff; background: rgba(255,255,255,0.05); }
        .m-tab.active { color: var(--cyan-accent); border-bottom-color: var(--cyan-accent); background: rgba(0, 240, 255, 0.1); }
        
        .top-tools { display: flex; gap: 10px; align-items: center; }
        .btn-session { background: rgba(251, 191, 36, 0.1); color: var(--gold-accent); border: 1px solid var(--gold-accent); padding: 5px 10px; border-radius: 6px; font-weight: bold; font-size: 0.8rem; cursor: pointer; transition: 0.2s;}
        .btn-session:hover { background: var(--gold-accent); color: #000; }
        .api-status { background: rgba(0,0,0,0.8); border: 1px solid var(--cyan-accent); padding: 5px 10px; border-radius: 6px; color: var(--cyan-accent); font-weight: 900; font-size: 0.85rem; box-shadow: 0 0 10px rgba(0, 240, 255, 0.2); }

        .main-workspace {
            display: flex; height: calc(100vh - 60px); width: 100vw; gap: 15px;
            padding: 15px; padding-left: 4vw; 
        }

        .col-left { flex: 0 0 28%; max-width: 28%; height: 100%; overflow-y: auto; background: var(--panel-bg); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); padding: 15px; }
        .col-center { flex: 0 0 44%; max-width: 44%; height: 100%; overflow-y: auto; background: var(--panel-bg); border-radius: 12px; border: 1px solid rgba(0,240,255,0.2); padding: 20px; box-shadow: 0 0 30px rgba(0,240,255,0.05); position: relative;}
        .col-right { flex: 0 0 24%; max-width: 24%; height: 100%; overflow-y: auto; background: var(--panel-bg); border-radius: 12px; border: 1px solid rgba(251,191,36,0.3); padding: 15px; display: flex; flex-direction: column;}

        .panel-view { display: none; }
        .panel-view.active { display: block; animation: fadeIn 0.3s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

        .section-title { font-size: 0.85rem; color: var(--gold-accent); margin: 1.5rem 0 1rem 0; text-transform: uppercase; font-weight: 900; border-bottom: 1px solid rgba(251,191,36,0.3); padding-bottom: 5px; letter-spacing: 1px;}
        .section-title:first-child { margin-top: 0; }
        .input-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; }
        .input-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 12px; }
        .input-box { background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.05); padding: 10px; border-radius: 8px; text-align: center; position: relative; }
        .input-box:focus-within { border-color: var(--cyan-accent); background: rgba(0,0,0,0.8);}
        .input-box label { display: block; font-size: 0.65rem; color: var(--text-muted); margin-bottom: 5px; text-transform: uppercase; font-weight: 900;}
        .input-box input, .input-box select { width: 100%; background: transparent; border: none; color: #fff; font-size: 1.2rem; font-weight: 900; text-align: center; outline: none; }
        
        .box-home input { border-bottom: 2px solid var(--cyan-accent); } .box-home label { color: var(--cyan-accent); }
        .box-away input { border-bottom: 2px solid var(--violet-accent); } .box-away label { color: var(--violet-accent); }

        .api-btn { width: 100%; background: linear-gradient(90deg, var(--cyan-accent), #00a2ff); color: #000; border: none; padding: 12px; border-radius: 8px; font-weight: 900; text-transform: uppercase; cursor: pointer; transition: 0.3s; font-size: 0.9rem; margin-bottom: 15px; box-shadow: 0 0 15px rgba(0,240,255,0.3);}
        .api-btn:hover { filter: brightness(1.2); box-shadow: 0 0 25px rgba(0,240,255,0.6); }

        .btn-broadcast { width: 100%; background: linear-gradient(90deg, #000, #0a1128); border: 2px solid var(--neon-green); color: var(--neon-green); padding: 12px; border-radius: 8px; font-weight: 900; text-transform: uppercase; cursor: pointer; transition: 0.3s; font-size: 1rem; margin-bottom: 20px; box-shadow: 0 0 15px rgba(0,255,0,0.2); letter-spacing: 1px;}
        .btn-broadcast:hover { background: var(--neon-green); color: #000; box-shadow: 0 0 25px rgba(0,255,0,0.6); }

        .hero-odds-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 20px;}
        .hero-box { background: linear-gradient(145deg, rgba(0,0,0,0.8), rgba(0,240,255,0.05)); border: 2px solid rgba(0,240,255,0.3); padding: 15px 5px; border-radius: 12px; text-align: center; cursor: pointer; transition: 0.2s; position: relative; overflow: hidden;}
        .hero-box:hover { border-color: var(--cyan-accent); box-shadow: 0 0 25px rgba(0,240,255,0.4); transform: scale(1.02);}
        .hero-name { font-size: 1.2rem; font-weight: 900; color: #fff; text-shadow: 0 0 5px rgba(255,255,255,0.5);}
        .hero-prob { font-size: 2.2rem; font-weight: 900; color: var(--cyan-accent); margin: 5px 0; text-shadow: 0 0 15px rgba(0,240,255,0.6);}
        .hero-odds { font-size: 1.1rem; color: var(--green-value); font-weight: 900;}
        .hero-box::after { content: '+ CARRELLO'; position: absolute; bottom: 0; left: 0; right: 0; background: var(--cyan-accent); color: #000; font-size: 0.7rem; font-weight: bold; padding: 2px; transform: translateY(100%); transition: 0.2s; }
        .hero-box:hover::after { transform: translateY(0); }

        .live-panel { background: rgba(239, 68, 68, 0.05); border: 1px solid rgba(239, 68, 68, 0.3); padding: 15px; border-radius: 10px; margin-bottom: 15px;}
        .live-title { color: var(--red-value); font-size: 0.8rem; font-weight: 900; text-align: center; margin-bottom: 10px; letter-spacing: 2px; display: flex; align-items: center; justify-content: center; gap: 5px;}
        .live-title::before, .live-title::after { content: '🔴'; font-size: 0.6rem; animation: blink 1s infinite; }
        @keyframes blink { 50% { opacity: 0; } }

        .possession-container { background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 15px; margin-bottom: 15px; text-align: center; }
        .poss-slider-wrapper { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
        .poss-label { font-size: 1.2rem; font-weight: 900; width: 50px;}
        .poss-label-h { color: var(--cyan-accent); text-align: right;}
        .poss-label-a { color: var(--violet-accent); text-align: left;}
        input[type=range].poss-slider { -webkit-appearance: none; width: 100%; background: rgba(255,255,255,0.1); height: 6px; border-radius: 3px; outline: none;}
        input[type=range].poss-slider::-webkit-slider-thumb { -webkit-appearance: none; height: 20px; width: 20px; border-radius: 50%; background: #fff; cursor: pointer; border: 3px solid var(--gold-accent); box-shadow: 0 0 10px rgba(251, 191, 36, 0.5); }
        
        .matrix-container { display: grid; grid-template-columns: 45px repeat(7, 1fr); gap: 3px; background: rgba(0,0,0,0.8); padding: 10px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.1); margin-bottom: 15px; }
        .matrix-cell { display: flex; align-items: center; justify-content: center; height: 35px; font-size: 0.85rem; font-weight: 900; color: #fff; border-radius: 4px; border: 1px solid rgba(255,255,255,0.1); text-shadow: 1px 1px 2px rgba(0,0,0,0.8);}
        .matrix-header-osp { color: var(--violet-accent); font-size: 0.85rem; font-weight: 900; text-align: center; display: flex; align-items: center; justify-content: center; border-bottom: 2px solid var(--violet-accent);}
        .matrix-header-home { color: var(--cyan-accent); font-size: 0.85rem; font-weight: 900; display: flex; align-items: center; justify-content: center; background: rgba(0,240,255,0.15); border-radius: 4px; border-right: 2px solid var(--cyan-accent);}
        .matrix-corner { font-size: 0.55rem; color: var(--text-muted); font-weight: 900; text-align: center; display: flex; flex-direction: column; justify-content: center; }

        .dual-radar-wrapper { display: flex; gap: 10px; margin-bottom: 15px; }
        .radar-container { flex: 1; background: rgba(0,0,0,0.6); border-radius: 8px; padding: 10px; border: 1px solid var(--green-value); }
        .radar-container-safe { border-color: var(--gold-accent); }
        .radar-header { font-size: 0.7rem; color: var(--green-value); font-weight: 900; text-transform: uppercase; margin-bottom: 8px; text-align: center; }
        .radar-header-safe { color: var(--gold-accent); }
        .radar-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .radar-box { background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 6px; padding: 8px; text-align: center; cursor: pointer; }
        .radar-box-safe { background: rgba(251, 191, 36, 0.1); border-color: rgba(251, 191, 36, 0.3); }
        .rb-name { font-size: 0.7rem; color: #fff; font-weight: bold; margin-bottom: 2px;}
        .rb-prob { font-size: 1.2rem; color: var(--green-value); font-weight: 900; }
        .radar-box-safe .rb-prob { color: var(--gold-accent); }
        .rb-odds { font-size: 0.6rem; color: var(--text-muted); font-weight:bold; margin-top: 2px; }

        .podium-container { display: flex; justify-content: space-between; gap: 10px; margin-bottom: 20px; }
        .podium-box { flex: 1; background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 10px; text-align: center; position: relative;}
        .podium-gold { border-color: var(--gold-accent); box-shadow: 0 5px 15px rgba(251, 191, 36, 0.1); border-top: 4px solid var(--gold-accent); }
        .podium-silver { border-color: #c0c0c0; border-top: 4px solid #c0c0c0; }
        .podium-bronze { border-color: #cd7f32; border-top: 4px solid #cd7f32; }
        .p-score { font-size: 1.8rem; font-weight: 900; color: #fff; display: block; letter-spacing: 2px;}
        .p-prob { font-size: 0.9rem; color: var(--cyan-accent); font-weight: 800;}

        .tabs-nav { display: flex; background: rgba(0,0,0,0.8); border-radius: 6px; overflow: hidden; margin-bottom: 10px; border: 1px solid rgba(255,255,255,0.1); }
        .tab-btn { flex: 1; background: transparent; color: var(--text-muted); border: none; padding: 10px; font-weight: 900; font-size: 0.7rem; text-transform: uppercase; cursor: pointer; border-bottom: 2px solid transparent; }
        .tab-btn.active { color: var(--cyan-accent); border-bottom-color: var(--cyan-accent); background: rgba(0, 240, 255, 0.05);}
        .tab-content { display: none; background: rgba(0,0,0,0.3); border-radius: 8px; padding: 10px; border: 1px solid rgba(255,255,255,0.05);}
        .tab-content.active { display: block; }
        
        .adv-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 8px; }
        .stat-card { background: rgba(0,0,0,0.7); border: 1px solid rgba(255,255,255,0.1); padding: 10px; text-align: center; border-radius: 6px; cursor: pointer; transition: 0.2s; position: relative; overflow:hidden;}
        .stat-card:hover { border-color: var(--cyan-accent); }
        .stat-name { font-size: 0.65rem; color: var(--text-main); font-weight: 900; display: block; margin-bottom: 4px;}
        .stat-prob { font-size: 1.2rem; font-weight: 900; color: var(--cyan-accent); display: block;}
        .stat-odds { font-size: 0.75rem; color: var(--green-value); font-weight: 800;}

        .ms-header { display: flex; flex-direction: column; gap: 10px; margin-bottom: 15px; border-bottom: 1px solid rgba(251,191,36,0.3); padding-bottom: 10px;}
        .ms-title { color: var(--gold-accent); font-size: 1.2rem; font-weight: 900; text-transform: uppercase; margin: 0; text-align: center;}
        .sys-toggle { background: #000; border: 1px solid var(--gold-accent); color: #fff; padding: 6px; border-radius: 6px; font-weight: bold; width: 100%; text-align: center;}
        
        .bank-container { display: flex; flex-direction: column; gap: 10px; margin-bottom: 15px;}
        .bank-input { background: rgba(0,0,0,0.8); border: 2px solid var(--gold-accent); color: #fff; padding: 10px; border-radius: 6px; text-align: center; font-weight: 900; font-size: 1.2rem; width: 100%; }
        
        .cart-list { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 10px; margin-bottom: 15px; overflow-y:auto; flex-grow:1;}
        .cart-item { background: rgba(0,0,0,0.5); padding: 10px; border-radius: 6px; margin-bottom: 8px; border: 1px solid rgba(255,255,255,0.1); position: relative;}
        .cart-match { font-weight: 900; font-size: 0.8rem; display: block; color: #fff;}
        .cart-market { color: var(--cyan-accent); font-size: 0.75rem; font-weight: bold; margin-top: 2px; display: block;}
        .cart-odds-row { display: flex; justify-content: space-between; align-items: center; margin-top: 6px;}
        .cart-odds-input { background: #000; border: 1px solid var(--green-value); color: #fff; font-weight: 900; width: 60px; text-align: center; padding: 4px; border-radius: 4px; font-size: 0.9rem;}
        .cart-result { font-size: 0.9rem; font-weight: 900; text-align: right;}
        .cart-remove { position: absolute; top: 5px; right: 5px; background: transparent; color: var(--red-value); border: none; cursor: pointer; font-weight: bold; font-size: 1rem;}

        .ms-grid { display: grid; grid-template-columns: 1fr; gap: 8px; margin-bottom: 15px; }
        .ms-box { background: rgba(0,0,0,0.6); padding: 10px; border-radius: 8px; text-align: center; border: 1px solid rgba(255,255,255,0.05); }
        .ms-label { font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase; font-weight: 900; display: block;}
        .ms-val { font-size: 1.4rem; font-weight: 900; color: #fff; }

        .btn-script { width: 100%; background: linear-gradient(90deg, #b026ff, #6d28d9); border: none; padding: 15px; color: #fff; font-weight: 900; font-size: 0.9rem; border-radius: 8px; cursor: pointer; text-transform: uppercase; margin-top: auto;}

        .val-positive { color: var(--green-value); }
        .val-negative { color: var(--red-value); }
        .val-roccaforte { color: var(--gold-accent); }

        .editor-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.95); backdrop-filter: blur(8px); display: none; justify-content: center; align-items: center; z-index: 2000; }
        .editor-content { background: #0a0f1e; border: 2px solid var(--violet-accent); padding: 25px; border-radius: 12px; width: 600px; max-width: 95%; box-shadow: 0 0 50px rgba(176, 38, 255, 0.2);}
        .editor-title { color: var(--violet-accent); font-weight: 900; text-transform: uppercase; margin-bottom: 15px; font-size: 1.2rem; text-align: center;}
        .editor-textarea { width: 100%; height: 300px; background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 10px; border-radius: 6px; font-family: monospace; font-size: 0.9rem; margin-bottom: 15px;}
        .editor-actions { display: flex; gap: 10px; }
        .editor-btn-pub { flex: 2; background: var(--green-value); color: #000; border: none; padding: 12px; border-radius: 6px; font-weight: 900; cursor: pointer; text-transform: uppercase;}
        .editor-btn-close { flex: 1; background: transparent; color: var(--text-muted); border: 1px solid var(--text-muted); padding: 12px; border-radius: 6px; font-weight: 900; cursor: pointer; text-transform: uppercase;}

        /* CSS BROADCAST OVERLAY FULL-SCREEN (V17) */
        .broadcast-screen {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background: #050505; z-index: 9999; display: none;
            flex-direction: column; align-items: center; justify-content: center;
            font-family: 'Segoe UI', sans-serif; cursor: pointer;
        }
        .bc-card {
            width: 85vw; max-width: 1400px; background: #0a0a0a;
            border: 4px solid var(--neon-green); border-radius: 24px;
            box-shadow: 0 0 50px rgba(0, 255, 0, 0.2), inset 0 0 20px rgba(0, 255, 0, 0.1);
            padding: 40px 60px; text-align: center;
        }
        .bc-league { background: #000; color: var(--neon-green); border: 2px solid var(--neon-green); padding: 5px 25px; border-radius: 20px; font-weight: 900; letter-spacing: 3px; display: inline-block; margin-bottom: 20px; font-size: 1.2rem;}
        .bc-title { font-size: 6rem; font-weight: 900; color: #ff6600; text-transform: uppercase; margin-bottom: 10px; letter-spacing: -2px; text-shadow: 0 0 20px rgba(255, 102, 0, 0.4);}
        .bc-title span { color: #fff; }
        .bc-match { font-size: 4rem; color: #fff; font-weight: 900; text-transform: uppercase; margin-bottom: 40px; display: flex; justify-content: center; align-items: center; gap: 30px; text-shadow: 0 0 15px rgba(255,255,255,0.3);}
        .bc-vs { color: var(--neon-green); font-size: 3rem; text-shadow: 0 0 20px var(--neon-green);}
        
        .bc-table-wrap { border: 3px solid var(--neon-green); border-radius: 16px; overflow: hidden; box-shadow: 0 0 30px rgba(0, 255, 0, 0.15);}
        .bc-table { width: 100%; border-collapse: collapse; background: rgba(0,255,0,0.02);}
        .bc-table th, .bc-table td { border: 1px solid var(--neon-green); padding: 25px 15px; text-align: center; font-size: 2.2rem; font-weight: 900; color: #fff; }
        .bc-table th { color: #fff; text-transform: uppercase; font-size: 1.6rem; padding: 20px; background: rgba(0,255,0,0.05);}
        .bc-footer { margin-top: 30px; color: rgba(255,255,255,0.5); font-size: 1.2rem; font-weight: bold; display: flex; justify-content: space-between; padding: 0 20px;}

        /* CSS Editor Modal Comparazione */
        .comp-editor-grid { display: grid; grid-template-columns: 100px repeat(6, 1fr); gap: 5px; margin-bottom: 15px; align-items:center;}
        .comp-editor-grid input { background: #000; border: 1px solid var(--neon-green); color: #fff; font-weight: bold; text-align: center; padding: 8px; border-radius: 4px; font-size: 1.1rem; width: 100%; outline: none;}
        .comp-editor-label { color: #fff; font-weight: 900; font-size: 0.9rem; text-align:center;}
    </style>
</head>
<body>
    <!-- BARRA DI REGIA -->
    <div class="top-nav">
        <div class="logo-area">BETBAR<span>-ORACLE</span></div>
        <div class="match-tabs" id="match-tabs-container"></div>
        <div class="top-tools">
            <select class="gc-select" id="match-count" onchange="initWorkspace()" title="Numero Slot Attivi">
                <option value="1">1 Match</option><option value="3" selected>3 Match</option><option value="5">5 Match</option>
            </select>
            <button class="btn-session" onclick="saveSession()">💾 Salva</button>
            <button class="btn-session" onclick="loadSession()">📂 Carica</button>
            <div class="api-status" title="API TheOdds">API: <span id="api-credits-used">0</span> / <span id="api-credits-total">500</span></div>
        </div>
    </div>

    <!-- MAIN WORKSPACE -->
    <div class="main-workspace">
        <!-- COLONNA 1: SALA MACCHINE -->
        <div class="col-left" id="col-left"></div>

        <!-- COLONNA 2: PALCOSCENICO -->
        <div class="col-center" id="col-center"></div>

        <!-- COLONNA 3: REGISTRATORE DI CASSA -->
        <div class="col-right">
            <div class="ms-header">
                <h3 class="ms-title">Cassa & Portfolio</h3>
                <select class="sys-toggle" id="slip-mode" onchange="renderCart()">
                    <option value="singole" selected>Modalità: SINGOLE</option>
                    <option value="multipla">Modalità: MULTIPLA</option>
                    <option value="sistema">Modalità: SISTEMA</option>
                </select>
            </div>

            <div class="bank-container">
                <div style="display: flex; gap:10px;">
                    <div style="flex:1"><label style="font-size:0.6rem; color:var(--text-muted); font-weight:bold; text-transform:uppercase;">Cassa Tot (€)</label><input type="number" id="master-bank" class="bank-input" value="1000" step="50" oninput="renderCart()"></div>
