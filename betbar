        function closeCompEditor() { document.getElementById('comp-editor-modal').style.display = 'none'; }

        function launchBroadcastOverlay() {
            // Chiudi modal editor
            closeCompEditor();
            
            // Popola nomi squadre e lega
            let l = document.getElementById(`m${activeMatchId}-league`).options[document.getElementById(`m${activeMatchId}-league`).selectedIndex].text;
            l = l.replace(/[^a-zA-Z\s]/g, '').trim().toUpperCase(); // Rimuove emoji
            document.getElementById('bc-league').textContent = l;
            document.getElementById('bc-home').textContent = (document.getElementById(`m${activeMatchId}-team-home`).value || "CASA").toUpperCase();
            document.getElementById('bc-away').textContent = (document.getElementById(`m${activeMatchId}-team-away`).value || "OSPITE").toUpperCase();

            // Trasferisci quote da Editor a Broadcast Screen
            const keys = ['1','x','2','o','u','g'];
            const books = ['gb','si','dz'];
            books.forEach(b => {
                keys.forEach(k => {
                    let val = document.getElementById(`ce-${b}-${k}`).value;
                    document.getElementById(`bo-${b}-${k}`).textContent = val || "-";
                });
            });

            // Mostra schermo nero
            document.getElementById('broadcast-screen').style.display = 'flex';
        }

        function closeBroadcastOverlay() {
            document.getElementById('broadcast-screen').style.display = 'none';
        }

        initWorkspace();
