            let html = ''; let totalTrueProb = 1; let totalBookieOdds = 1; let systemOddsArr = []; let totalKellyStake = 0; let activeSingles = [];
            globalCart.forEach((item, index) => {
                let dropLimit = (1 / item.prob) * 1.05; let bOdds = item.bookieOdds; let bNet = bOdds - 1; let q = 1 - item.prob; let kellyPct = bNet > 0 ? ((item.prob * bNet) - q) / bNet : 0; let rawStake = kellyPct > 0 ? bank * (kellyPct / 4) : 0; 
                if(bOdds > 1) { totalTrueProb *= item.prob; totalBookieOdds *= bOdds; systemOddsArr.push(bOdds); if(bOdds > (1/item.prob) && rawStake > 0) activeSingles.push({index: index, matchId: item.matchId, rawStake: rawStake, finalStake: 0}); }
                let resultHTML = "---"; let resClass = "";
                if(bOdds > 1) { if(bOdds > (1/item.prob)) { resultHTML = mode === 'singole' ? '' : "Value"; resClass = "val-positive"; } else if (item.prob >= 0.75) { resultHTML = "🔒 Sicura"; resClass = "val-roccaforte"; } else { resultHTML = "Scartata"; resClass = "val-negative"; } }
                html += `<div class="cart-item"><div class="cart-match">${item.matchName.toUpperCase()}</div><div class="cart-market">${item.market} <span style="color:var(--text-muted); font-weight:normal;">(DL: @${dropLimit.toFixed(2)})</span></div><div class="cart-odds-row"><div><input type="number" class="cart-odds-input" value="${item.bookieOdds || ''}" step="0.05" min="1" placeholder="@" oninput="updateCartOdds(${index}, this.value)"></div><div class="cart-result ${resClass}" id="cr-${index}">${resultHTML}</div></div><button class="cart-remove" onclick="removeFromCart(${index})">X</button></div>`;
            });
            container.innerHTML = html;
            if(mode === 'singole') {
                gridMultipla.style.display = "none"; gridSistema.style.display = "none"; sysOptions.style.display = "none"; gridSingole.style.display = "block"; document.getElementById('cap-box').style.display = "block"; document.getElementById('match-cap-box').style.display = "block";
                let matchExposure = {}; activeSingles.forEach(s => { if(!matchExposure[s.matchId]) matchExposure[s.matchId] = 0; matchExposure[s.matchId] += s.rawStake; }); let matchCapAmount = bank * (matchCapPerc / 100);
                activeSingles.forEach(s => { s.finalStake = matchExposure[s.matchId] > matchCapAmount ? s.rawStake * (matchCapAmount / matchExposure[s.matchId]) : s.rawStake; totalKellyStake += s.finalStake; });
                let globalCapAmount = bank * (capPerc / 100); let scaleFactor = totalKellyStake > globalCapAmount ? globalCapAmount / totalKellyStake : 1; let finalTotal = 0;
                activeSingles.forEach(s => { let actualStake = s.finalStake * scaleFactor; finalTotal += actualStake; document.getElementById(`cr-${s.index}`).innerHTML = `<span style="font-size:0.65rem;color:var(--text-muted);">Esposizione</span><br>€ ${actualStake.toFixed(0)}`; document.getElementById(`cr-${s.index}`).className = "cart-result val-positive"; });
                document.getElementById('ptf-total-invest').textContent = `€ ${finalTotal.toFixed(0)} / € ${globalCapAmount.toFixed(0)}`;
            } else if (mode === 'multipla') {
                document.getElementById('cap-box').style.display = "none"; document.getElementById('match-cap-box').style.display = "none"; gridMultipla.style.display = "grid"; gridSistema.style.display = "none"; gridSingole.style.display = "none"; sysOptions.style.display = "none";
                let totalTrueOdds = totalTrueProb > 0 ? 1 / totalTrueProb : 9999; document.getElementById('ms-bookie').textContent = `@ ${totalBookieOdds.toFixed(2)}`;
                let edge = ((totalBookieOdds / totalTrueOdds) - 1) * 100; let bNet = totalBookieOdds - 1; let q = 1 - totalTrueProb; let kellyPct = bNet > 0 ? ((totalTrueProb * bNet) - q) / bNet : 0; 
                const edgeUi = document.getElementById('ms-edge'); const kellyUi = document.getElementById('ms-kelly');
                if(edge > 0) { edgeUi.className = "ms-val val-positive"; edgeUi.textContent = `+${edge.toFixed(1)}%`; if(kellyPct > 0) { kellyUi.className = "ms-val val-positive"; kellyUi.textContent = `€${(bank*kellyPct/4).toFixed(0)}`; } else { kellyUi.className = "ms-val val-negative"; kellyUi.textContent = "NO"; } } else { edgeUi.className = "ms-val val-negative"; edgeUi.textContent = `${edge.toFixed(1)}%`; kellyUi.className = "ms-val val-negative"; kellyUi.textContent = "NO"; }
            } else {
                document.getElementById('cap-box').style.display = "none"; document.getElementById('match-cap-box').style.display = "none"; gridMultipla.style.display = "none"; gridSistema.style.display = "grid"; gridSingole.style.display = "none"; sysOptions.style.display = "block";
                let activeLegs = systemOddsArr.length; let currentK = parseInt(sysSelect.value); sysSelect.innerHTML = ""; for(let k=1; k<=activeLegs; k++) { let opt = document.createElement('option'); opt.value = k; opt.textContent = `${k} su ${activeLegs}`; sysSelect.appendChild(opt); } if(currentK && currentK <= activeLegs) sysSelect.value = currentK;
                let k = parseInt(sysSelect.value) || activeLegs; let combos = getCombinations(systemOddsArr, k); let totalCombos = combos.length; let stakePerCol = bank / totalCombos; 
                let maxWin = 0; let minWin = 999999; combos.forEach(combo => { let comboMult = 1; combo.forEach(odd => comboMult *= odd); let win = comboMult * stakePerCol; maxWin += win; if(win < minWin) minWin = win; }); if(totalCombos === 1) minWin = maxWin; if(totalCombos === 0) { minWin=0; maxWin=0; stakePerCol=0; }
                document.getElementById('sys-combos').textContent = totalCombos; document.getElementById('sys-stake').textContent = `€ ${stakePerCol.toFixed(2)}`; document.getElementById('sys-win-max').textContent = `€ ${maxWin.toFixed(2)}`;
            }
        }

        async function fetchOddsH2H(id) {
            let teamHomeRaw = document.getElementById(`m${id}-team-home`).value; let teamAwayRaw = document.getElementById(`m${id}-team-away`).value; const leagueKey = document.getElementById(`m${id}-league`).value; const btn = document.querySelector(`#left-panel-${id} .api-btn`);
            if(!teamHomeRaw || !teamAwayRaw) { alert("Inserisci le Squadre per scansionare."); return; }
            const normHome = translateTeam(teamHomeRaw); const normAway = translateTeam(teamAwayRaw);
            btn.textContent = "⏳ CERCO..."; btn.style.background = "var(--gold-accent)"; btn.style.color = "#000";
            try {
                const url = `https://api.the-odds-api.com/v4/sports/${leagueKey}/odds/?apiKey=${API_KEY}&regions=eu&markets=h2h,totals`; const response = await fetch(url);
                const remaining = response.headers.get('x-requests-remaining'); const used = response.headers.get('x-requests-used'); if(remaining !== null && used !== null) { const u = parseInt(used); const r = parseInt(remaining); document.getElementById('api-credits-used').textContent = u; document.getElementById('api-credits-total').textContent = u + r; const badge = document.querySelector('.api-status'); if(r <= 50) badge.classList.add('api-warning'); else badge.classList.remove('api-warning'); }
                if (!response.ok) throw new Error("Errore API.");
                const data = await response.json(); let matchFound = false; let bestOdds = {"1": 0, "X": 0, "2": 0, "O 2.5": 0, "U 2.5": 0};
                for (let match of data) { let apiHome = match.home_team.toLowerCase(); let apiAway = match.away_team.toLowerCase(); if (apiHome.includes(normHome) || normHome.includes(apiHome) || apiAway.includes(normAway) || normAway.includes(apiAway) || apiHome.includes(normAway) || apiAway.includes(normHome)) { matchFound = true; match.bookmakers.forEach(bookie => { bookie.markets.forEach(market => { if (market.key === 'h2h') { market.outcomes.forEach(outcome => { let outName = outcome.name.toLowerCase(); if ((outName === apiHome || outName.includes(normHome) || normHome.includes(outName)) && outcome.price > bestOdds["1"]) bestOdds["1"] = outcome.price; if ((outName === apiAway || outName.includes(normAway) || normAway.includes(outName)) && outcome.price > bestOdds["2"]) bestOdds["2"] = outcome.price; if (outName === "draw" && outcome.price > bestOdds["X"]) bestOdds["X"] = outcome.price; }); } if (market.key === 'totals') { market.outcomes.forEach(outcome => { let outName = outcome.name.toLowerCase(); if (outName === "over" && outcome.point === 2.5 && outcome.price > bestOdds["O 2.5"]) bestOdds["O 2.5"] = outcome.price; if (outName === "under" && outcome.point === 2.5 && outcome.price > bestOdds["U 2.5"]) bestOdds["U 2.5"] = outcome.price; }); } }); }); break; } }
                if (matchFound && (bestOdds["1"] > 0 || bestOdds["O 2.5"] > 0)) { ["1", "X", "2", "O 2.5", "U 2.5"].forEach(mk => { if(bestOdds[mk] > 0) { if(!globalCart.some(i => i.matchId === id && i.market === mk)) addToCart(id, mk); globalCart.forEach((item, index) => { if(item.matchId === id && item.market === mk) updateCartOdds(index, bestOdds[mk]); }); } }); btn.textContent = "✅ QUOTE NEL CARRELLO!"; btn.style.background = "var(--green-value)"; btn.style.color = "#fff"; } else { alert("Match non trovato sul database."); btn.textContent = "📡 Auto-Scan API TheOdds"; btn.style.background = "linear-gradient(90deg, var(--cyan-accent), #00a2ff)"; }
            } catch (e) { alert(e.message); btn.textContent = "📡 Auto-Scan API TheOdds"; btn.style.background = "linear-gradient(90deg, var(--cyan-accent), #00a2ff)"; }
            setTimeout(() => {btn.textContent = "📡 Auto-Scan API TheOdds"; btn.style.background = "linear-gradient(90deg, var(--cyan-accent), #00a2ff)"; btn.style.color = "#000";}, 4000);
        }

        function openEditor() { generateDraftText(); document.getElementById('editor-modal').style.display = 'flex'; }
        function closeEditor() { document.getElementById('editor-modal').style.display = 'none'; }
        function generateDraftText() {
            if(globalCart.length === 0) { document.getElementById('editor-text').value = "Carrello vuoto."; return; }
            const mode = document.getElementById('slip-mode').value; const risk = document.getElementById('editor-risk').value; let bank = parseFloat(document.getElementById('master-bank').value) || 1000; let capPerc = parseFloat(document.getElementById('master-cap').value) || 20; let matchCapPerc = parseFloat(document.getElementById('match-cap').value) || 10;
            let title = mode === 'sistema' ? '𝗦𝗜𝗦𝗧𝗘𝗠𝗔 𝗠𝗔𝗦𝗧𝗘𝗥' : (mode === 'singole' ? '𝗣𝗢𝗥𝗧𝗙𝗢𝗟𝗜𝗢 𝗦𝗜𝗡𝗚𝗢𝗟𝗘' : '𝗠𝗨𝗟𝗧𝗜𝗣𝗟𝗔 𝗠𝗔𝗦𝗧𝗘𝗥'); let script = `🔥 𝗕𝗘𝗧𝗕𝗔𝗥 𝗢𝗥𝗔𝗖𝗟𝗘: ${title} 🔥\n\n`;
            if(risk === 'low') script += `✅ Rischio: Basso\n\n`; else if(risk === 'high') script += `🚨 Rischio: ALTO\n\n`;
            let totalTrueProb = 1; let totalBookieOdds = 1; let systemOddsArr = []; let totalKellyStake = 0; let scaleFactor = 1; let matchExposure = {};
            if(mode === 'singole') { globalCart.forEach(item => { let bNet = item.bookieOdds - 1; let q = 1 - item.prob; let kellyPct = bNet > 0 ? ((item.prob * bNet) - q) / bNet : 0; if(item.bookieOdds > (1/item.prob) && kellyPct > 0) { let rawStk = bank * (kellyPct / 4); if(!matchExposure[item.matchId]) matchExposure[item.matchId] = 0; matchExposure[item.matchId] += rawStk; } }); let matchCapAmount = bank * (matchCapPerc / 100); globalCart.forEach(item => { let bNet = item.bookieOdds - 1; let q = 1 - item.prob; let kellyPct = bNet > 0 ? ((item.prob * bNet) - q) / bNet : 0; if(item.bookieOdds > (1/item.prob) && kellyPct > 0) { let rawStk = bank * (kellyPct / 4); let matchScale = matchExposure[item.matchId] > matchCapAmount ? (matchCapAmount / matchExposure[item.matchId]) : 1; totalKellyStake += rawStk * matchScale; } }); let capAmount = bank * (capPerc / 100); if(totalKellyStake > capAmount) scaleFactor = capAmount / totalKellyStake; }
            let roccaforteText = ""; let speculativaText = ""; let nobetText = "";
            globalCart.forEach(item => { let dropLimit = (1 / item.prob) * 1.05; let bOddsStr = item.bookieOdds > 0 ? `@${item.bookieOdds.toFixed(2)}` : `@...`; let isValue = item.bookieOdds > (1 / item.prob); let isSafe = item.prob >= 0.75; let entry = `🎯 ${item.matchName.toUpperCase()} 👉 ${item.market} (${bOddsStr})\n`; if (isSafe && !isValue) { entry += `    └ Affidabilità: ${(item.prob*100).toFixed(1)}%\n\n`; roccaforteText += entry; } else if (isValue) { entry += `    └ Drop Limit: @${dropLimit.toFixed(2)}\n`; if (mode === 'singole') { let bNet = item.bookieOdds - 1; let q = 1 - item.prob; let kellyPct = bNet > 0 ? ((item.prob * bNet) - q) / bNet : 0; if(kellyPct > 0 && item.bookieOdds > 1) { let rawStk = bank * (kellyPct / 4); let matchCapAmount = bank * (matchCapPerc / 100); let matchScale = matchExposure[item.matchId] > matchCapAmount ? (matchCapAmount / matchExposure[item.matchId]) : 1; let finalStake = rawStk * matchScale * scaleFactor; entry += `    └ Fiducia: € ${finalStake.toFixed(0)}\n`; } } entry += `\n`; speculativaText += entry; } else { entry += `    └ Scartata\n\n`; nobetText += entry; } if(item.bookieOdds > 1 && (isValue || mode !== 'singole')) { totalTrueProb *= item.prob; totalBookieOdds *= item.bookieOdds; systemOddsArr.push(item.bookieOdds); } });
            if (roccaforteText) script += `🧱 ROCCAFORTI (Multiple)\n${roccaforteText}`; if (speculativaText) script += `💣 SPECULATIVE (Valore)\n${speculativaText}`; if (nobetText && mode === 'singole') script += `❌ SCARTATE\n${nobetText}`;
            if(mode === 'multipla' && totalBookieOdds > 1) { let edge = ((totalBookieOdds / (1/totalTrueProb)) - 1) * 100; script += `💸 QUOTA TOTALE: @${totalBookieOdds.toFixed(2)}\n`; if(edge > 0) script += `✅ Vantaggio Matematico: +${edge.toFixed(1)}%\n`; } else if (mode === 'sistema' && systemOddsArr.length > 0) { let k = document.getElementById('sys-k').value; script += `⚙️ SISTEMA: ${k} su ${systemOddsArr.length}\n`; } 
            document.getElementById('editor-text').value = script;
        }
        function copyAndPublish() { let text = document.getElementById('editor-text').value; navigator.clipboard.writeText(text).then(() => { let btn = document.querySelector('.editor-btn-pub'); btn.textContent = "✅ COPIATO!"; setTimeout(()=> { btn.textContent = "🚀 Copia testo"; closeEditor();}, 2000); }); }

