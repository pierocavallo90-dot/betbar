        function openCompEditor(id) {
            let m = matchDataStore[id];
            if(!m) { alert("Attendi il calcolo del match."); return; }
            // Helper per precompilare aggiungendo una micro-varianza estetica per simulare i book diversi
            const getOdd = (k, offset) => { let p = m[k]; if(!p || p<=0) return "-"; let o = 1/p; return (o + offset).toFixed(2); };
            
            document.getElementById('ce-gb-1').value = getOdd('1', -0.01); document.getElementById('ce-gb-x').value = getOdd('X', 0); document.getElementById('ce-gb-2').value = getOdd('2', 0.02);
            document.getElementById('ce-gb-o').value = getOdd('O 2.5', -0.02); document.getElementById('ce-gb-u').value = getOdd('U 2.5', 0); document.getElementById('ce-gb-g').value = getOdd('GG', -0.01);
            
            document.getElementById('ce-si-1').value = getOdd('1', 0.02); document.getElementById('ce-si-x').value = getOdd('X', 0); document.getElementById('ce-si-2').value = getOdd('2', -0.01);
            document.getElementById('ce-si-o').value = getOdd('O 2.5', -0.03); document.getElementById('ce-si-u').value = getOdd('U 2.5', 0.02); document.getElementById('ce-si-g').value = getOdd('GG', -0.02);
            
            document.getElementById('ce-dz-1').value = getOdd('1', 0); document.getElementById('ce-dz-x').value = getOdd('X', -0.03); document.getElementById('ce-dz-2').value = getOdd('2', -0.02);
            document.getElementById('ce-dz-o').value = getOdd('O 2.5', 0); document.getElementById('ce-dz-u').value = getOdd('U 2.5', 0.01); document.getElementById('ce-dz-g').value = getOdd('GG', 0);

            document.getElementById('comp-editor-modal').style.display = 'flex';
